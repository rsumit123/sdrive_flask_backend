# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/your_database_name

# Flask Secret Key (generate a random secret key for production)
SECRET_KEY=your-secret-key-here

# AWS S3 Configuration
AWS_APP_ACCESS_KEY_ID=your-aws-access-key-id
AWS_APP_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_APP_S3_REGION_NAME=us-west-2
AWS_APP_STORAGE_BUCKET_NAME=your-bucket-name

# Email Configuration (for email verification)
# If using SMTP:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# If using AWS SES:
AWS_SES_REGION=us-west-2
AWS_SES_ACCESS_KEY_ID=your-ses-access-key
AWS_SES_SECRET_ACCESS_KEY=your-ses-secret-key

